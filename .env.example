# Server-only Tushare Pro credential. Configure it in Vercel; never expose it to Vite.
TUSHARE_TOKEN=

# Server-only secret automatically sent by Vercel Cron as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Managed Vercel Blob store identifier. Prefer the connected-store OIDC integration in production.
BLOB_STORE_ID=

# Local or off-Vercel Blob fallback only. Vercel production should use rotating OIDC credentials.
BLOB_READ_WRITE_TOKEN=

# Optional exact browser origin allowed to read the public API cross-origin.
# When omitted, the Vercel production URL is used automatically.
PUBLIC_APP_ORIGIN=
